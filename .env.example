# Copy to .env and edit. Every setting in src/rag_app/config.py can be set here with the RAG_ prefix.
OPENAI_API_KEY=sk-...

RAG_PG_HOST=localhost
RAG_PG_PORT=5544          # matches the host port exposed by docker-compose.yml
RAG_PG_USER=rag
RAG_PG_PASSWORD=rag
RAG_PG_DATABASE=rag
RAG_PG_TABLE=chunks

RAG_DATA_DIR=data/raw

RAG_EMBED_PROVIDER=huggingface
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBED_DIM=384

RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
# For vLLM:  RAG_LLM_PROVIDER=vllm  RAG_LLM_API_BASE=http://localhost:8000/v1  RAG_LLM_MODEL=<served model name>
